{
  "name": "claude-warden",
  "version": "0.1.0",
  "description": "An independent watchdog that audits every Claude Code tool call for malicious activity and fatal mistakes, before it runs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "warden": "./dist/cli.js"
  },
  "main": "./dist/pipeline.js",
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs smoke",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "claude",
    "claude-code",
    "security",
    "hook",
    "agent",
    "guardrail",
    "prompt-injection"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
